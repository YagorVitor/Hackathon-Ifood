# Copie para .env e preencha com as credenciais do agente no portal iFood.
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_REDIRECT_URI=http://localhost:8000/auth/callback
# Carrinho: acrescente (separados por espaço) os escopos aprovados no portal para
# endereços (listAddresses) e carrinho (createCart/getCart), copiando as strings exatas.
IFOOD_SCOPES=mcp.discovery.search.read
IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
